# This file is at repo root as .env.example — web reads from root via envDir: '../' (see web/vite.config.ts).
# For web-only setups you can also copy to web/.env:  cp ../.env.example ./.env
# See ../.env.example for all vars (PUBLIC_URL, CORS, VITE_GATEWAY_URL).
VITE_PORT=5173
VITE_GATEWAY_URL=http://localhost:8080
# For Cloudflare Tunnel (UI on same gateway, keep relative — CORS not needed):
# PUBLIC_URL=https://ai-gateway.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://ai-gateway.yourdomain.com
# For separate frontend -> tunnel, set absolute:
# VITE_PUBLIC_URL=https://ai-gateway.yourdomain.com
