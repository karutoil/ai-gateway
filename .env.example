# AI Gateway — example configuration.
# Copy to .env next to the gateway binary (Docker Compose does this for you and
# generates strong values for the secrets). Every variable is optional; the
# values below are the defaults unless noted.

# production enables strength checks (strong ADMIN_PASSWORD, explicit
# MASTER_KEY/JWT_SECRET, non-wildcard CORS). Leave unset for dev.
#ENV=production

# HTTP listener port.
PORT=8080

# Dashboard admin password. Dev default is admin123; production refuses it.
ADMIN_PASSWORD=change-me

# 64 hex chars (32 bytes). Encrypts provider credentials at rest.
# Generate: openssl rand -hex 32
MASTER_KEY=

# >=32 chars. Signs dashboard sessions.
JWT_SECRET=

# Public URL of the gateway (https://gateway.example.com). Used for CORS and
# canonical links. Empty -> CORS allows "*" (dev only; production rejects).
PUBLIC_URL=

# Comma-separated extra allowed origins, or "*" to allow all (dev only).
CORS_ALLOWED_ORIGINS=

# Comma-separated trusted proxy IPs/CIDRs for X-Forwarded-* handling.
TRUSTED_PROXIES=

# Database: postgres:// DSN (recommended) or a SQLite path (relative paths
# resolve against the working directory). The gateway auto-migrates either
# engine on boot; moving data between engines:
#   go run ./scripts/migrate-sqlite-pg.go ./data/gateway.db \
#     "postgres://gateway:gateway@127.0.0.1:5433/gateway?sslmode=disable"
DATABASE_URL=./data/gateway.db

# Optional Redis for shared cache + rate limiting: redis://host:6379
REDIS_URL=

# Response cache lifetime in seconds (exact-match requests within the TTL are
# answered from cache with X-Cache: HIT — no upstream call, no token spend).
CACHE_TTL_SECONDS=10
# Extend the exact-match cache to STREAMING requests: a clean stream's exact
# SSE bytes are replayed for identical requests. Streaming traffic gets zero
# benefit from the cache without this.
CACHE_STREAMS=false

# Log request/response bodies for debugging (privacy-sensitive).
LOG_BODIES=false
# Delete request logs older than N days (0 = keep forever).
LOG_RETENTION_DAYS=0
