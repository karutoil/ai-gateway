# Production build overrides (applied over .env when running `vite build`).
#
# The dashboard must call the gateway same-origin with relative /api paths:
# api.ts leaves the API base empty when no VITE_* URL is set. Without this
# file, the dev-only VITE_GATEWAY_URL=http://localhost:8787 from .env leaks
# into the built bundle and the browser's CSP (connect-src 'self') blocks
# every dashboard request.
#
# Leave VITE_GATEWAY_URL empty here. `npm run dev` still uses .env (dev
# mode), so the local proxy setup is unaffected.
VITE_GATEWAY_URL=
